---
// PostLayout.astro
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  category?: string;
  tags?: string[];
  type?: 'blog' | 'field' | 'lab';
  backUrl?: string;
  backText?: string;
}

const {
  title,
  description,
  pubDate,
  author = "Kadeem Manning",
  category,
  tags = [],
  type = 'blog',
  backUrl = '/blog',
  backText = 'Back to All Articles'
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${title} | Kadeem Manning`} description={description}>
  <!-- Scroll Reading Progress Bar -->
  <div id="progress-bar" class="reading-progress-bar"></div>

  <article class="site-container article-wrapper">
    <div class="article-header glass-card">
      <div class="card-body">
        <a href={backUrl} class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>{backText}</span>
        </a>

        <div class="article-meta-row">
          {category && <span class={`badge-tag badge-${type}`}>{category}</span>}
          <span class="meta-date">Published on {formattedDate}</span>
          <span class="meta-author">By {author}</span>
        </div>

        <h1 class="article-title">{title}</h1>
        <p class="article-lead">{description}</p>

        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <span class="tag-pill">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Article Body -->
    <div class="prose glass-card article-content">
      <div class="card-body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-wrapper {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .article-header {
    background: var(--glass-bg);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-primary);
    margin-bottom: 1.5rem;
    transition: transform var(--transition-fast);
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  .article-meta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .article-title {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .article-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .article-content {
    padding: 1rem 0;
  }

  @media (max-width: 768px) {
    .article-title { font-size: 1.8rem; }
    .article-lead { font-size: 1rem; }
  }
</style>

<script is:inline>
  // Scroll progress listener
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const bar = document.getElementById('progress-bar');
    if (bar) {
      bar.style.width = scrolled + '%';
    }
  });
</script>
