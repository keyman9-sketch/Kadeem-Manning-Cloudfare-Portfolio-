---
// BentoGrid.astro
import BentoCard from './BentoCard.astro';
import { getCollection } from 'astro:content';
import resumeData from '../data/resume.json';

const blogPosts = await getCollection('blog');
const fieldGuides = await getCollection('guides-field');
const labGuides = await getCollection('guides-lab');
const projects = await getCollection('projects');

const latestBlog = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const latestField = fieldGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const latestLab = labGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const featuredProjects = projects.sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<div class="bento-grid">
  <!-- 1. HERO BIO CARD (Col-Span-8) -->
  <div class="glass-card col-span-8 hero-card">
    <div class="card-body hero-body">
      <div class="hero-header">
        <img src="/avatar.svg" alt={resumeData.fullName} class="hero-avatar" />
        <div class="hero-status">
          <div class="beacon">
            <span class="beacon-dot"></span>
            <span>{resumeData.status}</span>
          </div>
          <span class="hero-loc">📍 {resumeData.location}</span>
        </div>
      </div>

      <h1 class="hero-title">
        <span class="hero-name-badge">Kadeem Manning</span>
        Laboratory Engineering, <span class="gradient-text">Field Metrology & Cleanroom R&D</span>
      </h1>
      <p class="hero-desc">
        {resumeData.summary}
      </p>

      <div class="hero-actions">
        <a href="/resume" class="btn btn-primary">
          <span>Interactive Career Timeline</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href={resumeData.pdfDownloadUrl} download class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Master Resume (PDF)</span>
        </a>
        <a href="/guides/library" class="btn btn-secondary">
          <span>Explore 87 SOP PDFs</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 2. "RESUME" PORTAL CARD (Col-Span-4) -->
  <BentoCard
    href="/resume"
    colSpan="col-span-4"
    variant="card-resume"
    icon="💼"
    badge="Career & Metrology"
    badgeType="resume"
    title="Resume"
    subtitle="Interactive career timeline, equipment index, target engineering roles, and downloadable PDF."
  >
    <div class="resume-preview-box">
      <div class="resume-stat">
        <span class="stat-num">{resumeData.experience.length}+</span>
        <span class="stat-label">Core Roles</span>
      </div>
      <div class="resume-stat">
        <span class="stat-num">AAS</span>
        <span class="stat-label">Engineering</span>
      </div>
      <div class="resume-stat">
        <span class="stat-num">9+ Yrs</span>
        <span class="stat-label">Tech Writing</span>
      </div>
    </div>
    <div class="card-footer-action">
      <span>Explore full timeline & skills →</span>
    </div>
  </BentoCard>

  <!-- 3. "PROCESS GUIDES (NOTES FROM THE FIELD)" CARD (Col-Span-6) -->
  <BentoCard
    href="/guides/field"
    colSpan="col-span-6"
    variant="card-field"
    icon="⚡"
    badge="Field Protocols & SRE"
    badgeType="field"
    title="Process Guides (Notes from the Field)"
    subtitle="Helium mass spectrometry leak testing, cryopump diagnostics, and ground conductivity metrology."
  >
    {latestField && (
      <div class="guide-snippet-box snippet-field">
        <div class="snippet-header">
          <span class="snippet-tag">Featured Field SOP</span>
          <span class="snippet-env">{latestField.data.environment}</span>
        </div>
        <h4 class="snippet-title">{latestField.data.title}</h4>
        <p class="snippet-desc">{latestField.data.description}</p>
        <div class="snippet-pill-row">
          {latestField.data.tags.slice(0, 3).map((tag: string) => (
            <span class="pill-mini">{tag}</span>
          ))}
        </div>
      </div>
    )}
    <div class="card-footer-action">
      <span>Browse all field notes & SOPs ({fieldGuides.length}) →</span>
    </div>
  </BentoCard>

  <!-- 4. "PROCESS GUIDES (NOTES FROM THE LAB)" CARD (Col-Span-6) -->
  <BentoCard
    href="/guides/lab"
    colSpan="col-span-6"
    variant="card-lab"
    icon="🧪"
    badge="R&D & Metrology"
    badgeType="lab"
    title="Process Guides (Notes from the Lab)"
    subtitle="Thin-film characterization, cleanroom environmental control, and audit-proof ALCOA+ logbooks."
  >
    {latestLab && (
      <div class="guide-snippet-box snippet-lab">
        <div class="snippet-header">
          <span class="snippet-tag">Standard Lab Protocol</span>
          <span class="snippet-env">ISO 14644-1 / ALCOA+</span>
        </div>
        <h4 class="snippet-title">{latestLab.data.title}</h4>
        <p class="snippet-desc">{latestLab.data.description}</p>
        <div class="snippet-pill-row">
          {latestLab.data.tags.slice(0, 3).map((tag: string) => (
            <span class="pill-mini">{tag}</span>
          ))}
        </div>
      </div>
    )}
    <div class="card-footer-action">
      <span>Inspect cleanroom & characterization SOPs ({labGuides.length}) →</span>
    </div>
  </BentoCard>

  <!-- 5. "BLOG" PORTAL CARD (Col-Span-7) -->
  <BentoCard
    href="/blog"
    colSpan="col-span-7"
    variant="card-blog"
    icon="✍️"
    badge="Technical Writing"
    badgeType="blog"
    title="Blog & Technical Publications"
    subtitle="Technical articles, research reviews, and engineering insights published across 9+ years."
  >
    {latestBlog && (
      <div class="blog-featured-snippet">
        <div class="blog-snippet-top">
          <span class="blog-cat">{latestBlog.data.category}</span>
          <span class="blog-time">{latestBlog.data.readTime}</span>
        </div>
        <h4 class="blog-snippet-title">{latestBlog.data.title}</h4>
        <p class="blog-snippet-desc">{latestBlog.data.description}</p>
      </div>
    )}
    <div class="card-footer-action">
      <span>Read technical articles ({blogPosts.length}) →</span>
    </div>
  </BentoCard>

  <!-- 6. TECH STACK BENTO CARD (Col-Span-5) -->
  <div class="glass-card col-span-5">
    <div class="card-body">
      <div class="card-top">
        <div class="card-icon-badge">🛠️</div>
        <span class="badge-tag">Core Tooling</span>
      </div>
      <h3 class="card-title">Specialized Toolchains</h3>
      <p class="card-subtitle">Technologies and equipment in active hands-on operation.</p>

      <div class="skills-pill-cloud">
        <span class="skill-pill">Helium Leak Detection</span>
        <span class="skill-pill">E-Beam Evaporators</span>
        <span class="skill-pill">Cryopumps</span>
        <span class="skill-pill">Turbomolecular Pumps</span>
        <span class="skill-pill">Geonics EM31/34</span>
        <span class="skill-pill">Siemens S7-1200/1500</span>
        <span class="skill-pill">SCADA Loops</span>
        <span class="skill-pill">Ellipsometry</span>
        <span class="skill-pill">Python</span>
        <span class="skill-pill">ALCOA+ QA/QC</span>
      </div>
    </div>
  </div>

  <!-- 7. FEATURED PROJECTS SHOWCASE (Col-Span-12) -->
  <div class="glass-card col-span-12">
    <div class="card-body">
      <div class="projects-header">
        <div>
          <span class="badge-tag">Engineering Highlights</span>
          <h3 class="card-title" style="margin-top: 0.5rem;">Selected Field & Laboratory Projects</h3>
        </div>
        <a href="/projects" class="btn btn-secondary btn-sm">View All Projects →</a>
      </div>

      <div class="projects-preview-grid">
        {featuredProjects.map((project) => (
          <div class="project-mini-card">
            <div class="project-top-row">
              <h4 class="project-name">{project.data.title}</h4>
              {project.data.metric && (
                <span class="project-metric-badge">{project.data.metric}</span>
              )}
            </div>
            <p class="project-desc">{project.data.description}</p>
            <div class="project-tech-list">
              {project.data.techStack.map((tech: string) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 8. CONNECT & CONTACT FORM CARD (Col-Span-12) -->
  <div id="connect" class="glass-card col-span-12 connect-card">
    <div class="card-body connect-body">
      <div class="connect-left">
        <span class="badge-tag badge-field">Get In Touch</span>
        <h3 class="connect-title">Let's connect for technical & engineering opportunities.</h3>
        <p class="connect-desc">Open for research laboratory technician, field metrology, instrumentation, and cleanroom engineering roles.</p>
        
        <div class="email-block">
          <span class="email-label">Website Contact Email:</span>
          <a href={`mailto:${resumeData.email}`} class="contact-email-link">
            ✉️ {resumeData.email}
          </a>
          <span class="alt-email">Personal: {resumeData.personalEmail}</span>
        </div>

        <div class="social-pills">
          <a href={resumeData.github} target="_blank" rel="noopener noreferrer" class="social-pill">GitHub</a>
          <a href={resumeData.pdfDownloadUrl} download class="social-pill">Resume (PDF)</a>
          <a href="/guides/library" class="social-pill">87 SOP Documents</a>
          <a href="/admin" class="social-pill cms-pill">Admin CMS</a>
        </div>
      </div>

      <!-- Interactive Contact Message Form -->
      <div class="connect-form-container glass-card">
        <form id="contact-form" class="contact-form">
          <h4 class="form-title">Send a Direct Message</h4>
          <div class="form-row">
            <input type="text" name="name" required placeholder="Your Name" class="form-input" />
            <input type="email" name="email" required placeholder="Your Email Address" class="form-input" />
          </div>
          <select name="inquiryType" class="form-input form-select">
            <option value="Recruiting">Role Opportunity / Recruitment</option>
            <option value="Consulting">Technical Consulting & Metrology</option>
            <option value="General">General Technical Inquiry</option>
          </select>
          <textarea name="message" required rows="3" placeholder="How can I assist with your laboratory, metrology, or engineering requirements?" class="form-input form-textarea"></textarea>
          
          <button type="submit" class="btn btn-primary btn-sm form-submit-btn">
            <span>Send Message</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
          <p id="form-status" class="form-status-msg"></p>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-card {
    background: radial-gradient(circle at 80% 20%, rgba(99, 102, 241, 0.15), transparent 60%), var(--glass-bg);
  }

  .hero-body {
    padding: 2.5rem;
    gap: 1.5rem;
  }

  .hero-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-avatar {
    width: 68px;
    height: 68px;
    border-radius: var(--radius-lg);
    border: 2px solid var(--border-hover);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .hero-status {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .hero-loc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .hero-name-badge {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent-cyan);
    margin-bottom: 0.25rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .gradient-text {
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 1.05rem;
    max-width: 680px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  /* Resume Stat Box */
  .resume-preview-box {
    display: flex;
    justify-content: space-between;
    background: var(--bg-subtle);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    margin: 1.25rem 0;
    border: 1px solid var(--border-subtle);
  }

  .resume-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-size: 1.3rem;
    font-weight: 800;
    font-family: var(--font-display);
    color: var(--accent-cyan);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Guide Snippet Box */
  .guide-snippet-box {
    background: var(--bg-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin: 1.25rem 0;
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .snippet-field {
    border-left: 3px solid var(--accent-emerald);
  }

  .snippet-lab {
    border-left: 3px solid var(--accent-rose);
  }

  .snippet-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .snippet-tag {
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .snippet-env {
    color: var(--text-secondary);
  }

  .snippet-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .snippet-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .snippet-pill-row {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .pill-mini {
    font-size: 0.7rem;
    background: var(--border-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    color: var(--text-secondary);
  }

  /* Blog Snippet */
  .blog-featured-snippet {
    background: var(--bg-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin: 1.25rem 0;
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-primary);
  }

  .blog-snippet-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .blog-cat {
    font-weight: 600;
    color: var(--accent-primary);
    text-transform: uppercase;
  }

  .blog-time {
    color: var(--text-muted);
  }

  .blog-snippet-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .blog-snippet-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .card-footer-action {
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-primary);
    display: flex;
    align-items: center;
  }

  /* Skills Cloud */
  .skills-pill-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .skill-pill {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .skill-pill:hover {
    background: var(--bg-secondary);
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  /* Projects Preview Grid */
  .projects-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .projects-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .project-mini-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-name {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .project-metric-badge {
    font-size: 0.75rem;
    font-weight: 600;
    background: rgba(16, 185, 129, 0.15);
    color: var(--accent-emerald);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .project-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .project-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tag {
    font-size: 0.75rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  /* Connect Card */
  .connect-card {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(16, 185, 129, 0.05)), var(--glass-bg);
  }

  .connect-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    padding: 2.5rem;
  }

  .connect-title {
    font-size: 1.6rem;
    margin: 0.5rem 0;
  }

  .connect-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .email-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
  }

  .email-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .contact-email-link {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .alt-email {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .social-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .social-pill {
    padding: 0.4rem 0.85rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .social-pill:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .cms-pill {
    border-color: rgba(99, 102, 241, 0.4);
    color: var(--accent-primary);
  }

  /* Form Container */
  .connect-form-container {
    background: var(--bg-subtle);
    padding: 1.5rem;
    border-radius: var(--radius-md);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
  }

  .form-input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.875rem;
    outline: none;
    font-family: inherit;
  }

  .form-input:focus {
    border-color: var(--accent-primary);
  }

  .form-select {
    cursor: pointer;
  }

  .form-textarea {
    resize: vertical;
  }

  .form-submit-btn {
    align-self: flex-start;
  }

  .form-status-msg {
    font-size: 0.85rem;
    color: var(--accent-emerald);
    display: none;
  }

  @media (max-width: 960px) {
    .hero-title { font-size: 1.6rem; }
    .hero-header { flex-direction: column; align-items: flex-start; }
    .hero-status { align-items: flex-start; }
    .projects-preview-grid { grid-template-columns: 1fr; }
    .connect-body { grid-template-columns: 1fr; }
    .form-row { flex-direction: column; }
  }
</style>

<script is:inline>
  const contactForm = document.getElementById('contact-form');
  const formStatus = document.getElementById('form-status');

  if (contactForm && formStatus) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      formStatus.style.display = 'block';
      formStatus.innerText = '✓ Thank you! Your message inquiry has been recorded.';
      contactForm.reset();
      setTimeout(() => {
        formStatus.style.display = 'none';
      }, 5000);
    });
  }
</script>
