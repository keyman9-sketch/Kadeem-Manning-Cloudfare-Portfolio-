---
// BentoGrid.astro
import BentoCard from './BentoCard.astro';
import { getCollection } from 'astro:content';
import resumeData from '../data/resume.json';

const blogPosts = await getCollection('blog');
const fieldGuides = await getCollection('guides-field');
const labGuides = await getCollection('guides-lab');
const projects = await getCollection('projects');

const latestBlog = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const latestField = fieldGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const latestLab = labGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const featuredProjects = projects.sort((a, b) => a.data.order - b.data.order).slice(0, 2);
---

<div class="bento-grid">
  <!-- 1. HERO BIO CARD (Col-Span-8) -->
  <div class="glass-card col-span-8 hero-card">
    <div class="card-body hero-body">
      <div class="hero-header">
        <img src="/avatar.svg" alt={resumeData.fullName} class="hero-avatar" />
        <div class="hero-status">
          <div class="beacon">
            <span class="beacon-dot"></span>
            <span>{resumeData.status}</span>
          </div>
          <span class="hero-loc">📍 {resumeData.location}</span>
        </div>
      </div>

      <h1 class="hero-title">
        Engineering distributed systems & <span class="gradient-text">edge-first web architectures</span>.
      </h1>
      <p class="hero-desc">
        {resumeData.summary}
      </p>

      <div class="hero-actions">
        <a href="/resume" class="btn btn-primary">
          <span>View Interactive Resume</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#connect" class="btn btn-secondary">Get in Touch</a>
      </div>
    </div>
  </div>

  <!-- 2. "RESUME" PORTAL CARD (Col-Span-4) -->
  <BentoCard
    href="/resume"
    colSpan="col-span-4"
    variant="card-resume"
    icon="💼"
    badge="Career & Skills"
    badgeType="resume"
    title="Resume"
    subtitle="Interactive timeline of engineering roles, achievements, skills, and downloadable PDF."
  >
    <div class="resume-preview-box">
      <div class="resume-stat">
        <span class="stat-num">{resumeData.experience.length}+</span>
        <span class="stat-label">Key Roles</span>
      </div>
      <div class="resume-stat">
        <span class="stat-num">99.99%</span>
        <span class="stat-label">SLA Delivered</span>
      </div>
      <div class="resume-stat">
        <span class="stat-num">120M+</span>
        <span class="stat-label">Daily Hits</span>
      </div>
    </div>
    <div class="card-footer-action">
      <span>Explore full timeline & skills →</span>
    </div>
  </BentoCard>

  <!-- 3. "PROCESS GUIDES (NOTES FROM THE FIELD)" CARD (Col-Span-6) -->
  <BentoCard
    href="/guides/field"
    colSpan="col-span-6"
    variant="card-field"
    icon="⚡"
    badge="SRE & Operations"
    badgeType="field"
    title="Process Guides (Notes from the Field)"
    subtitle="Battle-tested deployment protocols, high-availability edge configurations, and outage mitigations."
  >
    {latestField && (
      <div class="guide-snippet-box snippet-field">
        <div class="snippet-header">
          <span class="snippet-tag">Latest Operational SOP</span>
          <span class="snippet-env">{latestField.data.environment}</span>
        </div>
        <h4 class="snippet-title">{latestField.data.title}</h4>
        <p class="snippet-desc">{latestField.data.description}</p>
        <div class="snippet-pill-row">
          {latestField.data.tags.slice(0, 3).map((tag: string) => (
            <span class="pill-mini">{tag}</span>
          ))}
        </div>
      </div>
    )}
    <div class="card-footer-action">
      <span>Browse all field notes & runbooks ({fieldGuides.length}) →</span>
    </div>
  </BentoCard>

  <!-- 4. "PROCESS GUIDES (NOTES FROM THE LAB)" CARD (Col-Span-6) -->
  <BentoCard
    href="/guides/lab"
    colSpan="col-span-6"
    variant="card-lab"
    icon="🧪"
    badge="R&D & Experiments"
    badgeType="lab"
    title="Process Guides (Notes from the Lab)"
    subtitle="Experimental benchmarks, WebAssembly runtime evaluations, and emerging technology tests."
  >
    {latestLab && (
      <div class="guide-snippet-box snippet-lab">
        <div class="snippet-header">
          <span class="snippet-tag">Active Research Note</span>
          <span class="snippet-env">Reproducibility: {latestLab.data.reproducibility}</span>
        </div>
        <h4 class="snippet-title">{latestLab.data.title}</h4>
        <p class="snippet-desc">{latestLab.data.description}</p>
        <div class="snippet-pill-row">
          {latestLab.data.tags.slice(0, 3).map((tag: string) => (
            <span class="pill-mini">{tag}</span>
          ))}
        </div>
      </div>
    )}
    <div class="card-footer-action">
      <span>Inspect research experiments & data ({labGuides.length}) →</span>
    </div>
  </BentoCard>

  <!-- 5. "BLOG" PORTAL CARD (Col-Span-7) -->
  <BentoCard
    href="/blog"
    colSpan="col-span-7"
    variant="card-blog"
    icon="✍️"
    badge="Engineering Essays"
    badgeType="blog"
    title="Blog"
    subtitle="Essays and technical write-ups on edge architectures, distributed computing, and modern UI performance."
  >
    {latestBlog && (
      <div class="blog-featured-snippet">
        <div class="blog-snippet-top">
          <span class="blog-cat">{latestBlog.data.category}</span>
          <span class="blog-time">{latestBlog.data.readTime}</span>
        </div>
        <h4 class="blog-snippet-title">{latestBlog.data.title}</h4>
        <p class="blog-snippet-desc">{latestBlog.data.description}</p>
      </div>
    )}
    <div class="card-footer-action">
      <span>Read all articles ({blogPosts.length}) →</span>
    </div>
  </BentoCard>

  <!-- 6. TECH STACK BENTO CARD (Col-Span-5) -->
  <div class="glass-card col-span-5">
    <div class="card-body">
      <div class="card-top">
        <div class="card-icon-badge">🛠️</div>
        <span class="badge-tag">Core Tooling</span>
      </div>
      <h3 class="card-title">Technical Mastery</h3>
      <p class="card-subtitle">Technologies and toolchains in active daily production.</p>

      <div class="skills-pill-cloud">
        <span class="skill-pill">Cloudflare Workers</span>
        <span class="skill-pill">Astro 5</span>
        <span class="skill-pill">TypeScript</span>
        <span class="skill-pill">Rust / WASM</span>
        <span class="skill-pill">Go</span>
        <span class="skill-pill">Cloudflare D1 / KV</span>
        <span class="skill-pill">Docker & K8s</span>
        <span class="skill-pill">Glassmorphism CSS</span>
      </div>
    </div>
  </div>

  <!-- 7. FEATURED PROJECTS SHOWCASE (Col-Span-12) -->
  <div class="glass-card col-span-12">
    <div class="card-body">
      <div class="projects-header">
        <div>
          <span class="badge-tag">Selected Works</span>
          <h3 class="card-title" style="margin-top: 0.5rem;">Featured Engineering Projects</h3>
        </div>
        <a href="/projects" class="btn btn-secondary btn-sm">View All Projects →</a>
      </div>

      <div class="projects-preview-grid">
        {featuredProjects.map((project) => (
          <div class="project-mini-card">
            <div class="project-top-row">
              <h4 class="project-name">{project.data.title}</h4>
              {project.data.metric && (
                <span class="project-metric-badge">{project.data.metric}</span>
              )}
            </div>
            <p class="project-desc">{project.data.description}</p>
            <div class="project-tech-list">
              {project.data.techStack.map((tech: string) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>
            <div class="project-links">
              {project.data.liveUrl && (
                <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="link-btn">
                  Live Demo ↗
                </a>
              )}
              {project.data.githubUrl && (
                <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="link-btn">
                  GitHub Code ↗
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 8. CONNECT / FOOTER CARD (Col-Span-12) -->
  <div id="connect" class="glass-card col-span-12 connect-card">
    <div class="card-body connect-body">
      <div class="connect-left">
        <h3 class="connect-title">Let's build something fast and resilient.</h3>
        <p class="connect-desc">Open for consulting, architectural reviews, and high-impact engineering leadership.</p>
      </div>
      <div class="connect-right">
        <a href={`mailto:${resumeData.email}`} class="btn btn-primary">
          <span>{resumeData.email}</span>
        </a>
        <div class="social-pills">
          <a href={resumeData.github} target="_blank" rel="noopener noreferrer" class="social-pill">GitHub</a>
          <a href={resumeData.linkedin} target="_blank" rel="noopener noreferrer" class="social-pill">LinkedIn</a>
          <a href="/admin" class="social-pill cms-pill">Admin CMS</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-card {
    background: radial-gradient(circle at 80% 20%, rgba(99, 102, 241, 0.15), transparent 60%), var(--glass-bg);
  }

  .hero-body {
    padding: 2.5rem;
    gap: 1.5rem;
  }

  .hero-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-avatar {
    width: 68px;
    height: 68px;
    border-radius: var(--radius-lg);
    border: 2px solid var(--border-hover);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .hero-status {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .hero-loc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .hero-title {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .gradient-text {
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 1.1rem;
    max-width: 680px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  /* Resume Stat Box */
  .resume-preview-box {
    display: flex;
    justify-content: space-between;
    background: var(--bg-subtle);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    margin: 1.25rem 0;
    border: 1px solid var(--border-subtle);
  }

  .resume-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-size: 1.4rem;
    font-weight: 800;
    font-family: var(--font-display);
    color: var(--accent-cyan);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Guide Snippet Box */
  .guide-snippet-box {
    background: var(--bg-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin: 1.25rem 0;
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .snippet-field {
    border-left: 3px solid var(--accent-emerald);
  }

  .snippet-lab {
    border-left: 3px solid var(--accent-rose);
  }

  .snippet-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .snippet-tag {
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .snippet-env {
    color: var(--text-secondary);
  }

  .snippet-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .snippet-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .snippet-pill-row {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .pill-mini {
    font-size: 0.7rem;
    background: var(--border-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    color: var(--text-secondary);
  }

  /* Blog Snippet */
  .blog-featured-snippet {
    background: var(--bg-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin: 1.25rem 0;
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-primary);
  }

  .blog-snippet-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .blog-cat {
    font-weight: 600;
    color: var(--accent-primary);
    text-transform: uppercase;
  }

  .blog-time {
    color: var(--text-muted);
  }

  .blog-snippet-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .blog-snippet-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .card-footer-action {
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-primary);
    display: flex;
    align-items: center;
  }

  /* Skills Cloud */
  .skills-pill-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .skill-pill {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .skill-pill:hover {
    background: var(--bg-secondary);
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  /* Projects Preview Grid */
  .projects-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .projects-preview-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .project-mini-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-name {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .project-metric-badge {
    font-size: 0.75rem;
    font-weight: 600;
    background: rgba(16, 185, 129, 0.15);
    color: var(--accent-emerald);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .project-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .project-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tag {
    font-size: 0.75rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  .project-links {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .link-btn {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-primary);
  }

  .link-btn:hover {
    text-decoration: underline;
  }

  /* Connect Card */
  .connect-card {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(16, 185, 129, 0.05)), var(--glass-bg);
  }

  .connect-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem;
  }

  .connect-title {
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .connect-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .connect-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }

  .social-pills {
    display: flex;
    gap: 0.6rem;
  }

  .social-pill {
    padding: 0.4rem 0.85rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .social-pill:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .cms-pill {
    border-color: rgba(99, 102, 241, 0.4);
    color: var(--accent-primary);
  }

  @media (max-width: 860px) {
    .hero-title { font-size: 1.6rem; }
    .hero-header { flex-direction: column; align-items: flex-start; }
    .hero-status { align-items: flex-start; }
    .projects-preview-grid { grid-template-columns: 1fr; }
    .connect-body { flex-direction: column; align-items: flex-start; }
    .connect-right { align-items: flex-start; }
  }
</style>
