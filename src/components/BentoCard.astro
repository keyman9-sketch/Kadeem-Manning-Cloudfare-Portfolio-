---
// BentoCard.astro
interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  badgeType?: 'field' | 'lab' | 'blog' | 'resume' | 'default';
  icon?: string;
  href?: string;
  colSpan?: 'col-span-12' | 'col-span-8' | 'col-span-7' | 'col-span-6' | 'col-span-5' | 'col-span-4' | 'col-span-3';
  variant?: 'card-field' | 'card-lab' | 'card-blog' | 'card-resume' | 'default';
  class?: string;
}

const {
  title,
  subtitle,
  badge,
  badgeType = 'default',
  icon,
  href,
  colSpan = 'col-span-4',
  variant = 'default',
  class: extraClass = ''
} = Astro.props;

const isClickable = !!href;
const Tag = isClickable ? 'a' : 'div';
---

<Tag 
  href={href} 
  class={`glass-card ${colSpan} ${variant !== 'default' ? variant : ''} ${isClickable ? 'clickable' : ''} ${extraClass}`}
>
  <div class="card-body">
    {(icon || badge || isClickable) && (
      <div class="card-top">
        <div class="top-left">
          {icon && <div class="card-icon-badge">{icon}</div>}
          {badge && <span class={`badge-tag badge-${badgeType}`}>{badge}</span>}
        </div>
        {isClickable && (
          <div class="card-action-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
        )}
      </div>
    )}

    {title && <h3 class="card-title">{title}</h3>}
    {subtitle && <p class="card-subtitle">{subtitle}</p>}

    <slot />
  </div>
</Tag>

<style>
  .top-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .card-subtitle {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>

<script>
  // Add mouse follower light effect to all glass cards
  document.querySelectorAll('.glass-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const mouseEvent = e as MouseEvent;
      const htmlCard = card as HTMLElement;
      const rect = htmlCard.getBoundingClientRect();
      const x = ((mouseEvent.clientX - rect.left) / htmlCard.clientWidth) * 100;
      const y = ((mouseEvent.clientY - rect.top) / htmlCard.clientHeight) * 100;
      htmlCard.style.setProperty('--mouse-x', `${x}%`);
      htmlCard.style.setProperty('--mouse-y', `${y}%`);
    });
  });
</script>
