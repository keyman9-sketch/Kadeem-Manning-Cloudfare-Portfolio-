---
// guides/library.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import documents from '../../data/documents.json';
---

<BaseLayout 
  title="Official SOP & Runbook Library (87 PDF Documents) | Kadeem Manning"
  description="Comprehensive library of Standard Operating Procedures (SOPs), calibration protocols, vacuum leak testing runbooks, and QA/QC checklists."
>
  <div class="site-container library-page">
    <div class="glass-card library-banner-card">
      <div class="card-body">
        <div class="banner-top">
          <div>
            <span class="badge-tag">Documentation Suite</span>
            <h1 class="banner-title">Standard Operating Procedures & Runbook Library</h1>
          </div>
          <a href="/resume" class="btn btn-secondary btn-sm">View Technical CV →</a>
        </div>
        <p class="banner-desc">
          Complete repository of 87 technical SOPs, calibration runbooks, cleanroom procedures, and QA/QC compliance checklists authored and maintained across laboratory and field operations.
        </p>

        <!-- Live Search & Filters -->
        <div class="filter-controls">
          <div class="search-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="doc-search" placeholder="Search 87 documents by equipment, standard, or keyword..." />
          </div>

          <div class="cat-filter-tabs" id="category-filters">
            <button class="cat-filter-btn active" data-cat="all">All ({documents.length})</button>
            <button class="cat-filter-btn" data-cat="Vacuum & Pumping Systems">Vacuum Systems</button>
            <button class="cat-filter-btn" data-cat="Field Calibration & Sensors">Field Calibration</button>
            <button class="cat-filter-btn" data-cat="Cleanroom & Thin-Film Lab">Cleanroom & Lab</button>
            <button class="cat-filter-btn" data-cat="QA/QC & Compliance">QA/QC & Compliance</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Documents Grid -->
    <div class="docs-grid" id="docs-list">
      {documents.map((doc) => (
        <div class="glass-card doc-card" data-title={doc.title.toLowerCase()} data-cat={doc.category} data-filename={doc.filename.toLowerCase()}>
          <div class="card-body">
            <div class="card-top">
              <span class={`badge-tag ${doc.isChecklist ? 'badge-lab' : 'badge-field'}`}>
                {doc.isChecklist ? 'Quick Checklist' : 'Standard SOP'}
              </span>
              <span class="doc-cat-pill">{doc.category}</span>
            </div>

            <h3 class="doc-title">{doc.title}</h3>

            <div class="doc-actions">
              <a href={doc.url} download class="btn btn-primary btn-sm doc-download-btn" title="Download official PDF document">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download PDF</span>
              </a>
              <a href={doc.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" title="View in browser">
                <span>View PDF ↗</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .library-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1rem;
  }

  .library-banner-card {
    background: radial-gradient(circle at 85% 15%, rgba(16, 185, 129, 0.15), transparent 60%), var(--glass-bg);
  }

  .banner-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .banner-title {
    font-size: 2.2rem;
    margin-top: 0.5rem;
  }

  .banner-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 850px;
    margin-bottom: 1.5rem;
  }

  .filter-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-box {
    position: relative;
    max-width: 600px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  .search-box input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    font-size: 0.95rem;
    outline: none;
    transition: all var(--transition-fast);
  }

  .search-box input:focus {
    border-color: var(--accent-emerald);
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.25);
    background: var(--bg-secondary);
  }

  .cat-filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-filter-btn {
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cat-filter-btn.active {
    background: var(--accent-emerald);
    color: #ffffff;
    border-color: var(--accent-emerald);
    box-shadow: 0 2px 10px rgba(16, 185, 129, 0.35);
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .doc-card {
    background: var(--glass-bg);
  }

  .doc-cat-pill {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .doc-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .doc-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 800px) {
    .docs-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  const search = document.getElementById('doc-search');
  const catButtons = document.querySelectorAll('.cat-filter-btn');
  const docCards = document.querySelectorAll('.doc-card');

  let activeCat = 'all';

  function filterDocs() {
    const q = search ? search.value.toLowerCase().trim() : '';
    docCards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const cat = card.getAttribute('data-cat') || '';
      const fn = card.getAttribute('data-filename') || '';

      const matchesSearch = !q || title.includes(q) || fn.includes(q);
      const matchesCat = activeCat === 'all' || cat === activeCat;

      if (matchesSearch && matchesCat) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  if (search) {
    search.addEventListener('input', filterDocs);
  }

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.getAttribute('data-cat') || 'all';
      filterDocs();
    });
  });
</script>
