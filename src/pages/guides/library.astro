---
// guides/library.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import documents from '../../data/documents.json';
---

<BaseLayout 
  title="Official SOP & Runbook Library (88 PDF Documents) | Kadeem Manning"
  description="Comprehensive repository of 88 high-vacuum standard operating procedures (SOPs), helium leak detection protocols, cleanroom standards, and QA/QC compliance checklists."
>
  <div class="site-container library-page">
    <div class="glass-card library-banner-card">
      <div class="card-body">
        <div class="banner-top">
          <div>
            <span class="badge-tag badge-field">Documentation & Procedures Suite</span>
            <h1 class="banner-title">Authentic Standard Operating Procedures (SOP) Library</h1>
          </div>
          <a href="/resume" class="btn btn-secondary btn-sm">View Technical CV →</a>
        </div>
        <p class="banner-desc">
          Searchable repository of <strong>88 official procedures</strong>, helium leak detection runbooks (DIN EN 1779), cryopump regeneration logs, cleanroom protocols (ISO 14644-1), and ALCOA+ audit-proof checklists. Hover over any card for a quick glance, or click to open the <strong>In-Browser PDF Reader</strong>.
        </p>

        <!-- Live Search & Category Tabs -->
        <div class="filter-controls">
          <div class="search-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="doc-search" placeholder="Search 88 documents by equipment (e.g. cryopump, turbo), standard, or keyword..." />
          </div>

          <div class="cat-filter-tabs" id="category-filters">
            <button class="cat-filter-btn active" data-cat="all">All ({documents.length})</button>
            <button class="cat-filter-btn" data-cat="Vacuum & Pumping Systems">Vacuum Systems</button>
            <button class="cat-filter-btn" data-cat="QA/QC & Compliance">QA/QC & Compliance</button>
            <button class="cat-filter-btn" data-cat="Cleanroom & Thin-Film Lab">Cleanroom & Lab</button>
            <button class="cat-filter-btn" data-cat="Field Metrology & Environmental">Field Metrology</button>
            <button class="cat-filter-btn" data-cat="Instrumentation & Controls">Controls & Sensors</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Count Status -->
    <div class="results-header">
      <span id="results-count" class="results-count-text">Showing all {documents.length} technical documents</span>
      <span class="interactive-hint">💡 Tip: Hover cards for quick preview or click "Read in Browser" to view without downloading.</span>
    </div>

    <!-- Documents Grid with Hover Preview & In-Browser Viewer Trigger -->
    <div class="docs-grid" id="docs-list">
      {documents.map((doc, idx) => (
        <div 
          class="glass-card doc-card" 
          data-title={doc.title.toLowerCase()} 
          data-cat={doc.category} 
          data-filename={doc.filename.toLowerCase()}
          data-url={doc.url}
          data-doc-name={doc.title}
        >
          <div class="card-body doc-card-body">
            <div class="card-top">
              <span class={`badge-tag ${doc.isChecklist ? 'badge-lab' : 'badge-field'}`}>
                {doc.isChecklist ? 'Verification Checklist' : 'Standard SOP'}
              </span>
              <span class="doc-cat-pill">{doc.category}</span>
            </div>

            <h3 class="doc-title">{doc.title}</h3>

            <!-- Hover Quick Info Snippet -->
            <div class="hover-preview-info">
              <div class="preview-metric-row">
                <span class="preview-key">Document Format:</span>
                <span class="preview-val">Authentic PDF (Direct Vector)</span>
              </div>
              <div class="preview-metric-row">
                <span class="preview-key">Category Scope:</span>
                <span class="preview-val">{doc.category}</span>
              </div>
            </div>

            <div class="doc-actions">
              <button 
                type="button" 
                class="btn btn-primary btn-sm open-viewer-btn" 
                data-url={doc.url} 
                data-title={doc.title}
                data-cat={doc.category}
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <span>Read in Browser</span>
              </button>

              <a href={doc.url} download class="btn btn-secondary btn-sm doc-download-btn" title="Download original PDF">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- IN-BROWSER PDF MODAL VIEWER -->
    <div id="pdf-modal" class="pdf-modal-overlay" style="display: none;">
      <div class="pdf-modal-dialog glass-card">
        <div class="pdf-modal-header">
          <div class="modal-header-left">
            <span id="modal-cat-badge" class="badge-tag badge-field">Standard SOP</span>
            <h3 id="modal-doc-title" class="modal-doc-title">Document Title</h3>
          </div>
          <div class="modal-header-actions">
            <a id="modal-open-tab" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" title="Open in new window">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>New Tab</span>
            </a>
            <a id="modal-download" href="#" download class="btn btn-primary btn-sm" title="Download PDF">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download</span>
            </a>
            <button id="modal-close-btn" type="button" class="btn btn-secondary btn-sm close-btn" title="Close modal (Esc)">
              ✕
            </button>
          </div>
        </div>

        <div class="pdf-modal-body">
          <iframe id="pdf-viewer-iframe" src="" class="pdf-iframe" title="PDF Document Viewer"></iframe>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .library-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .library-banner-card {
    background: radial-gradient(circle at 85% 15%, rgba(16, 185, 129, 0.15), transparent 60%), var(--glass-bg);
  }

  .banner-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .banner-title {
    font-size: 2.2rem;
    margin-top: 0.5rem;
    font-weight: 800;
  }

  .banner-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 850px;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .filter-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-box {
    position: relative;
    max-width: 650px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  .search-box input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    font-size: 0.95rem;
    outline: none;
    transition: all var(--transition-fast);
  }

  .search-box input:focus {
    border-color: var(--accent-emerald);
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.25);
    background: var(--bg-secondary);
  }

  .cat-filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-filter-btn {
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cat-filter-btn:hover {
    border-color: var(--accent-emerald);
    color: var(--text-primary);
  }

  .cat-filter-btn.active {
    background: var(--accent-emerald);
    color: #ffffff;
    border-color: var(--accent-emerald);
    box-shadow: 0 2px 10px rgba(16, 185, 129, 0.35);
  }

  .results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    padding: 0 0.5rem;
  }

  .results-count-text {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .interactive-hint {
    color: var(--accent-cyan);
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .doc-card {
    background: var(--glass-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    transition: all var(--transition-medium);
    position: relative;
    overflow: hidden;
  }

  .doc-card:hover {
    border-color: var(--accent-emerald);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25), 0 0 20px rgba(16, 185, 129, 0.15);
  }

  .doc-card-body {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
  }

  .doc-cat-pill {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .doc-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0.75rem 0 1rem 0;
    line-height: 1.4;
    color: var(--text-primary);
  }

  /* Hover Quick Info */
  .hover-preview-info {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8rem;
    opacity: 0.85;
    transition: opacity var(--transition-fast);
  }

  .doc-card:hover .hover-preview-info {
    opacity: 1;
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.05);
  }

  .preview-metric-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .preview-key {
    color: var(--text-muted);
  }

  .preview-val {
    color: var(--text-primary);
    font-weight: 600;
  }

  .doc-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  /* IN-BROWSER PDF MODAL */
  .pdf-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .pdf-modal-dialog {
    width: 100%;
    max-width: 1100px;
    height: 90vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-primary);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-lg);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }

  .pdf-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .modal-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 250px;
  }

  .modal-doc-title {
    font-size: 1.1rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 550px;
  }

  .modal-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .close-btn {
    font-size: 1.1rem;
    padding: 0.45rem 0.8rem;
    cursor: pointer;
  }

  .pdf-modal-body {
    flex: 1;
    width: 100%;
    height: 100%;
    background: #1e293b;
    position: relative;
  }

  .pdf-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (max-width: 900px) {
    .docs-grid { 
      grid-template-columns: 1fr; 
    }
    .pdf-modal-dialog {
      height: 95vh;
      padding: 0;
    }
    .modal-doc-title {
      max-width: 250px;
    }
  }
</style>

<script is:inline>
  const search = document.getElementById('doc-search');
  const catButtons = document.querySelectorAll('.cat-filter-btn');
  const docCards = document.querySelectorAll('.doc-card');
  const resultsCount = document.getElementById('results-count');

  // Modal elements
  const modal = document.getElementById('pdf-modal');
  const modalIframe = document.getElementById('pdf-viewer-iframe');
  const modalTitle = document.getElementById('modal-doc-title');
  const modalCatBadge = document.getElementById('modal-cat-badge');
  const modalOpenTab = document.getElementById('modal-open-tab');
  const modalDownload = document.getElementById('modal-download');
  const modalCloseBtn = document.getElementById('modal-close-btn');

  let activeCat = 'all';

  function filterDocs() {
    const q = search ? search.value.toLowerCase().trim() : '';
    let visibleCount = 0;

    docCards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const cat = card.getAttribute('data-cat') || '';
      const fn = card.getAttribute('data-filename') || '';

      const matchesSearch = !q || title.includes(q) || fn.includes(q);
      const matchesCat = activeCat === 'all' || cat === activeCat;

      if (matchesSearch && matchesCat) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} of ${docCards.length} technical documents`;
    }
  }

  if (search) {
    search.addEventListener('input', filterDocs);
  }

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.getAttribute('data-cat') || 'all';
      filterDocs();
    });
  });

  // Open In-Browser Viewer Modal
  function openPdfModal(url, title, cat) {
    if (!modal || !modalIframe) return;
    modalTitle.textContent = title;
    modalCatBadge.textContent = cat || 'SOP Document';
    modalIframe.src = url;
    modalOpenTab.href = url;
    modalDownload.href = url;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closePdfModal() {
    if (!modal || !modalIframe) return;
    modal.style.display = 'none';
    modalIframe.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.open-viewer-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const url = btn.getAttribute('data-url');
      const title = btn.getAttribute('data-title');
      const cat = btn.getAttribute('data-cat');
      openPdfModal(url, title, cat);
    });
  });

  if (modalCloseBtn) {
    modalCloseBtn.addEventListener('click', closePdfModal);
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closePdfModal();
      }
    });
  }

  // Keyboard shortcut: Escape to close
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
      closePdfModal();
    }
  });
</script>
