---
// guides/lab.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides-lab');
const sortedGuides = guides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout 
  title="Process Guides (Notes from the Lab) | Alex Mercer"
  description="Experimental benchmarks, WebAssembly isolate research, and prototype evaluations."
>
  <div class="site-container lab-page">
    <!-- Lab Header Banner -->
    <div class="glass-card lab-banner-card card-lab">
      <div class="card-body">
        <div class="banner-top">
          <div>
            <span class="badge-tag badge-lab">R&D & Benchmarks</span>
            <h1 class="banner-title">Process Guides (Notes from the Lab)</h1>
          </div>
          <a href="/admin" class="btn btn-primary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Log Experiment (CMS)</span>
          </a>
        </div>
        <p class="banner-desc">
          Empirical research logs, runtime benchmarks, WebAssembly experimentation, and prototyping notes exploring the bleeding edge of distributed software.
        </p>
      </div>
    </div>

    <!-- Guides List -->
    <div class="guides-grid">
      {sortedGuides.map((guide) => {
        const formattedDate = guide.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });

        return (
          <a href={`/guides/lab/${guide.slug}`} class="glass-card guide-card card-lab clickable">
            <div class="card-body">
              <div class="card-top">
                <div class="meta-pills">
                  <span class="badge-tag badge-lab">Lab Experiment</span>
                  <span class="env-pill">Reproducibility: {guide.data.reproducibility}</span>
                </div>
                <div class="card-action-arrow">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </div>
              </div>

              <h2 class="guide-title">{guide.data.title}</h2>
              <p class="guide-desc">{guide.data.description}</p>

              {guide.data.hypothesis && (
                <div class="hypothesis-box">
                  <span class="hypothesis-label">Tested Hypothesis:</span>
                  <p class="hypothesis-text">"{guide.data.hypothesis}"</p>
                </div>
              )}

              <div class="guide-bottom-row">
                <span class="guide-date">Conducted: {formattedDate}</span>
                <span class="read-action">Inspect Lab Findings →</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .lab-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1rem;
  }

  .lab-banner-card {
    background: radial-gradient(circle at 85% 15%, rgba(244, 63, 94, 0.15), transparent 60%), var(--glass-bg);
  }

  .banner-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .banner-title {
    font-size: 2.2rem;
    margin-top: 0.5rem;
  }

  .banner-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 800px;
  }

  .guides-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .meta-pills {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .env-pill {
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .guide-title {
    font-size: 1.45rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .guide-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .hypothesis-box {
    background: var(--bg-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    border-left: 3px solid var(--accent-rose);
  }

  .hypothesis-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--accent-rose);
    display: block;
    margin-bottom: 0.35rem;
  }

  .hypothesis-text {
    font-size: 0.875rem;
    font-style: italic;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .guide-bottom-row {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .guide-date {
    color: var(--text-muted);
  }

  .read-action {
    font-weight: 600;
    color: var(--accent-rose);
  }
</style>
