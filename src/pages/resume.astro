---
// resume.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import resumeData from '../data/resume.json';
---

<BaseLayout 
  title={`Master Resume & Technical CV | ${resumeData.fullName}`}
  description={`High-Vacuum Chamber Operations, Thin-Film Deposition, Helium Leak Detection, and ALCOA+ QA/QC Compliance experience of ${resumeData.fullName}.`}
>
  <div class="site-container resume-page">
    <!-- Resume Header Card -->
    <div class="glass-card resume-header-card">
      <div class="card-body">
        <div class="resume-top-row">
          <div class="resume-title-block">
            <span class="badge-tag badge-resume">Curriculum Vitae</span>
            <h1 class="resume-name">{resumeData.fullName}</h1>
            <p class="resume-role">{resumeData.title}</p>
            <p class="resume-loc">📍 {resumeData.location} • ✉️ {resumeData.email}</p>
          </div>

          <div class="resume-actions-block">
            <a href={resumeData.pdfDownloadUrl} download class="btn btn-primary btn-sm" title="Download Official Master Resume PDF">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download Master Resume (PDF)</span>
            </a>
            <button onclick="window.print()" class="btn btn-secondary btn-sm" title="Print or save as PDF">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              <span>Print Clean Copy</span>
            </button>
          </div>
        </div>

        <p class="resume-bio">{resumeData.summary}</p>
      </div>
    </div>

    <!-- Target Professional Roles Banner -->
    {resumeData.targetRoles && (
      <div class="glass-card target-roles-card">
        <div class="card-body">
          <div class="card-top">
            <div class="card-icon-badge">🎯</div>
            <span class="badge-tag">Target Specializations</span>
          </div>
          <h3 class="card-title">Target Professional Areas</h3>
          <div class="target-roles-grid">
            {resumeData.targetRoles.map((role: string) => (
              <div class="role-pill-item">
                <span class="pill-check">✓</span>
                <span>{role}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- Interactive Career Timeline with Filter Tabs -->
    <div class="glass-card timeline-card">
      <div class="card-body">
        <div class="timeline-header">
          <div>
            <span class="badge-tag">Hands-On Experience</span>
            <h2 class="section-heading">Professional Career Timeline</h2>
          </div>

          <!-- Category Filter Tabs -->
          <div class="filter-tabs" id="resume-filters">
            <button class="filter-btn active" data-filter="all">All Disciplines</button>
            <button class="filter-btn" data-filter="High-Vacuum & Thin-Film R&D">High-Vacuum R&D</button>
            <button class="filter-btn" data-filter="Materials Characterization & QA/QC">QA/QC & Materials</button>
            <button class="filter-btn" data-filter="Field Metrology & Calibration">Field Metrology</button>
            <button class="filter-btn" data-filter="Controls & Automation">Controls & Automation</button>
          </div>
        </div>

        <!-- Experience Timeline List -->
        <div class="timeline-list">
          {resumeData.experience.map((exp, index) => (
            <div class="timeline-item" data-category={exp.category}>
              <div class="timeline-marker">
                <div class="marker-dot"></div>
                {index !== resumeData.experience.length - 1 && <div class="marker-line"></div>}
              </div>

              <div class="timeline-content glass-card">
                <div class="card-body">
                  <div class="role-header">
                    <div>
                      <h3 class="role-title">{exp.role}</h3>
                      <h4 class="company-name">{exp.company} • <span class="role-loc">{exp.location}</span></h4>
                    </div>
                    <div class="role-meta">
                      <span class="period-badge">{exp.period}</span>
                      <span class="cat-badge">{exp.category}</span>
                    </div>
                  </div>

                  <ul class="highlights-list">
                    {exp.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Skills & Education Grid -->
    <div class="resume-subgrid">
      <!-- Technical Skills Matrix -->
      <div class="glass-card">
        <div class="card-body">
          <div class="card-top">
            <div class="card-icon-badge">🧠</div>
            <span class="badge-tag">Core Competencies</span>
          </div>
          <h3 class="card-title">Technical Skills & Equipment Mastery</h3>
          
          <div class="skills-sections">
            {resumeData.skills.map((group) => (
              <div class="skill-group">
                <h4 class="skill-group-title">{group.category}</h4>
                <div class="skill-tag-row">
                  {group.items.map((skill) => (
                    <span class="skill-tag">{skill}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Education & Credentials -->
      <div class="glass-card">
        <div class="card-body">
          <div class="card-top">
            <div class="card-icon-badge">🎓</div>
            <span class="badge-tag">Education</span>
          </div>
          <h3 class="card-title">Education & Technical Foundation</h3>

          <div class="credentials-box">
            {resumeData.education.map((edu) => (
              <div class="edu-item">
                <h4 class="edu-degree">{edu.degree}</h4>
                <p class="edu-inst">{edu.institution} ({edu.period})</p>
                {edu.details && <p class="edu-desc">{edu.details}</p>}
              </div>
            ))}

            <div class="cert-box">
              <h4 class="cert-heading">Licenses & Field Credentials</h4>
              <ul class="cert-list">
                <li>✨ Class A CDL Commercial Driver (OTR & Logistics)</li>
                <li>✨ Defense Contractor Cleanroom Compliance (ALCOA+ / EPA QAPP)</li>
                <li>✨ Hazardous Chemical Handling & Contamination Control</li>
                <li>✨ Remote Field Operations & High-Voltage SRE Protocol</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .resume-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1rem;
  }

  .resume-header-card {
    background: radial-gradient(circle at 90% 10%, rgba(6, 182, 212, 0.15), transparent 60%), var(--glass-bg);
  }

  .resume-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .resume-name {
    font-size: 2.4rem;
    font-weight: 800;
    margin: 0.5rem 0 0.25rem 0;
  }

  .resume-role {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin-bottom: 0.5rem;
  }

  .resume-loc {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .resume-actions-block {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .resume-bio {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 900px;
  }

  /* Target Roles */
  .target-roles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .role-pill-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-subtle);
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .pill-check {
    color: var(--accent-emerald);
    font-weight: 700;
  }

  /* Timeline */
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .filter-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--accent-cyan);
    color: var(--text-primary);
  }

  .filter-btn.active {
    background: var(--accent-cyan);
    color: #0b0f19;
    border-color: var(--accent-cyan);
    box-shadow: 0 2px 8px rgba(6, 182, 212, 0.3);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 1.5rem;
    transition: opacity var(--transition-medium);
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    margin-top: 1.5rem;
  }

  .marker-line {
    flex: 1;
    width: 2px;
    background: var(--border-subtle);
    margin: 0.5rem 0;
  }

  .timeline-content {
    margin-bottom: 1.5rem;
    background: var(--bg-subtle);
  }

  .role-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .role-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .company-name {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .role-loc {
    color: var(--text-muted);
  }

  .role-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .period-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .cat-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .highlights-list li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .highlights-list li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-cyan);
  }

  /* Subgrid */
  .resume-subgrid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 1.5rem;
  }

  .skills-sections {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .skill-group-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .skill-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-tag {
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--text-primary);
  }

  .credentials-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .edu-item {
    background: var(--bg-subtle);
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .edu-degree {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .edu-inst {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0.25rem 0;
  }

  .edu-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .cert-box {
    background: var(--bg-subtle);
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .cert-heading {
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .cert-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .target-roles-grid {
      grid-template-columns: 1fr;
    }
    .resume-subgrid {
      grid-template-columns: 1fr;
    }
  }

  /* Print Styles */
  @media print {
    body {
      background: white !important;
      color: black !important;
    }
    .resume-header-card, .glass-card, .timeline-content {
      background: none !important;
      border: 1px solid #ccc !important;
      box-shadow: none !important;
    }
    .resume-actions-block, #resume-filters {
      display: none !important;
    }
    .period-badge, .cat-badge, .skill-tag, .role-pill-item {
      border: 1px solid #ccc !important;
      color: black !important;
      background: none !important;
    }
  }
</style>

<script is:inline>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const timelineItems = document.querySelectorAll('.timeline-item');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      timelineItems.forEach((item) => {
        const cat = item.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          item.style.display = 'grid';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
