---
// blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout 
  title="Engineering & Metrology Blog | Kadeem Manning"
  description="Technical articles, research reviews, and engineering insights published across 9+ years of laboratory and field operations."
>
  <div class="site-container blog-index-page">
    <!-- Blog Hero Banner -->
    <div class="glass-card blog-banner-card">
      <div class="card-body">
        <div class="banner-top">
          <div>
            <span class="badge-tag badge-blog">Engineering Essays</span>
            <h1 class="banner-title">Architectural & Systems Blog</h1>
          </div>
          <a href="/admin" class="btn btn-primary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Write New Post (CMS)</span>
          </a>
        </div>
        <p class="banner-desc">
          Long-form technical essays exploring edge runtimes, resilient microservices, high-throughput caching, and tactile interface design.
        </p>

        <!-- Live Search Input -->
        <div class="search-box">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="blog-search" placeholder="Search essays by title, topic, or keyword..." />
        </div>
      </div>
    </div>

    <!-- Posts Grid -->
    <div class="blog-grid" id="blog-posts-grid">
      {sortedPosts.map((post) => {
        const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });

        return (
          <a href={`/blog/${post.slug}`} class="glass-card blog-card card-blog clickable" data-title={post.data.title.toLowerCase()} data-tags={post.data.tags.join(' ').toLowerCase()} data-desc={post.data.description.toLowerCase()}>
            <div class="card-body">
              <div class="card-top">
                <span class="badge-tag badge-blog">{post.data.category}</span>
                <span class="read-time">{post.data.readTime}</span>
              </div>

              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>

              <div class="post-bottom-row">
                <span class="post-date">{formattedDate}</span>
                <span class="read-more-action">Read Article →</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-index-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1rem;
  }

  .blog-banner-card {
    background: radial-gradient(circle at 85% 15%, rgba(99, 102, 241, 0.15), transparent 60%), var(--glass-bg);
  }

  .banner-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .banner-title {
    font-size: 2.2rem;
    margin-top: 0.5rem;
  }

  .banner-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 800px;
    margin-bottom: 1.5rem;
  }

  .search-box {
    position: relative;
    max-width: 600px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  .search-box input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    font-size: 0.95rem;
    outline: none;
    transition: all var(--transition-fast);
  }

  .search-box input:focus {
    border-color: var(--accent-primary);
    box-shadow: 0 0 15px rgba(99, 102, 241, 0.25);
    background: var(--bg-secondary);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .blog-card {
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .post-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .post-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .post-bottom-row {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .post-date {
    color: var(--text-muted);
  }

  .read-more-action {
    font-weight: 600;
    color: var(--accent-primary);
  }

  .read-time {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 800px) {
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  const searchInput = document.getElementById('blog-search');
  const cards = document.querySelectorAll('.blog-card');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const tags = card.getAttribute('data-tags') || '';
        const desc = card.getAttribute('data-desc') || '';
        if (title.includes(q) || tags.includes(q) || desc.includes(q)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }
</script>
